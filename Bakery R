          </div>
          <div class="field">
            <label for="delivery">Date &amp; time of delivery <span class="hint">11AM earliest pickup</span></label>
            <input id="delivery" name="delivery" type="datetime-local" required>
          </div>
          <div class="field">
            <label for="payment">Mode of payment</label>
            <select id="payment" name="payment" required>
              <option value="">Select payment</option>
              <option>GCash</option>
              <option>BPI</option>
              <option>SeaBank</option>
            </select>
          </div>
          <div class="field">
            <label for="baseColor">Cake base color/s</label>
            <input id="baseColor" name="baseColor" type="text">
          </div>
          <div class="field full">
            <label for="design">Cake design</label>
            <textarea id="design" name="design" placeholder="Describe your dream design, or note that you'll send a reference photo"></textarea>
          </div>
          <div class="field full">
            <label for="dedication">Dedication</label>
            <input id="dedication" name="dedication" type="text" placeholder="What should the cake say?">
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Send Order Details</button>
          <span class="form-note">Opens your email app with everything pre-filled.</span>
        </div>
      </form>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="panel panel-cream" id="faq">
    <div class="wrap">
      <div class="panel-head">
        <p class="eyebrow" style="color:var(--olive)">FAQs</p>
        <h2>Good to<br><em>know.</em></h2>
      </div>
      <div class="faq-list">
        <div class="faq-item">
          <button class="faq-q">What time can I pick up my cake? <span class="icon">+</span></button>
